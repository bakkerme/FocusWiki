{
  "schemaVersion": 1,
  "appName": "Cairn Repository Documentation Hub",
  "defaultBaseUrl": "http://127.0.0.1:8088",
  "alternateBaseUrls": [
    "http://100.117.116.91:8088"
  ],
  "targets": [
    {
      "id": "doc-initial-edit",
      "label": "Document Initial View (Current Visual Edit Default)",
      "defaultSelected": true,
      "actualAppState": "visual-edit-default",
      "honestStateNote": "App currently opens directly in TipTap visual edit mode with text-label formatting toolbar, left repository/document sidebar, and open right review margin. Proposed read-first viewer mode is not yet implemented.",
      "route": "/?project=cindervault-rpg&doc=docs%2Fvault-breach-action.md",
      "projectId": "cindervault-rpg",
      "docPath": "docs/vault-breach-action.md",
      "captureScope": "viewport",
      "viewport": {
        "width": 1440,
        "height": 900,
        "deviceScaleFactor": 1,
        "colorScheme": "light",
        "reducedMotion": true
      },
      "steps": [
        { "kind": "navigate" },
        { "kind": "ensureMode", "mode": "visual" },
        { "kind": "ensureReviewSidebar", "open": true, "showResolved": false },
        { "kind": "scrollContainerTop", "selector": ".sheet-scroll", "top": 0 }
      ],
      "readiness": {
        "requiredSelectors": [
          ".workbench",
          ".nav-sidebar",
          ".repo-topbar",
          ".editor-toolbar",
          ".ProseMirror h1",
          ".ProseMirror table",
          ".review-sidebar",
          ".save-badge.saved"
        ],
        "waitForFonts": true,
        "waitForVisibleEmbeds": false,
        "assertSavedState": true,
        "timeoutMs": 12000
      }
    },
    {
      "id": "source-editing",
      "label": "Markdown Source Mode (Current Centered Textarea)",
      "defaultSelected": true,
