{
  "name": "focuswiki",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted repository documentation hub with visual Markdown editing, sandboxed embeds, and portable anchored comments",
  "type": "module",
  "scripts": {
    "seed": "tsx scripts/seed-repos.ts",
    "dev:server": "tsx watch server/index.ts --local-dev",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "capture": "tsx scripts/capture.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-link": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-table-cell": "3.34.0",
    "@tiptap/extension-table-header": "3.34.0",
    "@tiptap/extension-table-row": "3.34.0",
    "@tiptap/extension-task-item": "3.34.0",
    "@tiptap/extension-task-list": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "chokidar": "^4.0.3",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.65.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "license": "MIT"
}
